# Backend Server Port
PORT=3001

# Node Environment (development, production)
NODE_ENV=development

# MongoDB Connection String
# For local development: mongodb://localhost:27017/cloud-cost-comparator
# For Docker: mongodb://mongodb:27017/cloud-cost-comparator
MONGODB_URI=mongodb://localhost:27017/cloud-cost-comparator

# JWT Secret for Authentication (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-secret-key-please-change-this

# API Keys (optional - for future real API integration)
AZURE_API_KEY=
AWS_API_KEY=
GCP_API_KEY=
